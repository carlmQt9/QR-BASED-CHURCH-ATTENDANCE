# ============================================================
# Laravel deployment for InfinityFree / shared hosting
# The web root (htdocs) is the project root, so every request
# is routed into the /public directory where Laravel lives.
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Block direct access to sensitive files ---
    RewriteRule ^\.env - [F,L,NC]

    # --- Send everything that is not a real root-level file into /public ---
    # /            -> public/index.php  (via public/.htaccess)
    # /login       -> public/index.php  (via public/.htaccess)
    # /build/...   -> public/build/...  (Vite assets served directly)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# --- Never serve these files directly ---
<FilesMatch "^(\.env|\.env\.|composer\.(json|lock)|\.gitignore)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Disable directory listing ---
Options -Indexes
